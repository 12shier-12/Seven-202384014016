    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
